# Verified sender in Resend, e.g. "Portfolio <hello@thedevpiyush.com>"
CONTACT_FROM_EMAIL=""
# Where notifications go; defaults to the email in personal_info
CONTACT_NOTIFY_EMAIL=""

# Optional: direct URL of the resume PDF (e.g. a Supabase public file). Falls back to the Google Doc export.
RESUME_PDF_URL=""
